# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
TTS_MODEL=tts-1                 # tts-1 (rápido/barato) o tts-1-hd (mejor calidad)
TTS_VOICE=nova                  # alloy|echo|fable|onyx|nova|shimmer
TTS_SPEED=1.0

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/iamasters

# Server
PORT=4100
CORS_ORIGIN=http://localhost:3000

# Ingest
PDF_UPLOAD_DIR=./tmp/uploads
MAX_UPLOAD_MB=25
